{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "content_scripts": [ {
      "css": [ "content.css" ],
      "js": [ "content.js" ],
      "matches": [ "*://*.chess.com/*" ]
   } ],
   "description": "Real-time chess analysis for Chess.com with best move arrows and auto-move functionality",
   "host_permissions": [ "*://*.chess.com/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Chess Analyzer Pro (Auto Move)",
   "permissions": [  ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.0",
   "web_accessible_resources": [ {
      "matches": [ "*://*.chess.com/*" ],
      "resources": [ "stockfish.js", "icons/crown.png" ]
   } ]
}
